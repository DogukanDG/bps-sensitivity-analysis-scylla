# Python venv
backend/venv/

# Node modules
frontend/node_modules/

# General OS junk
.DS_Store
Thumbs.db

# output files
output/

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Docker images
docker_prebuilt_images/

# Bundled JRE tarball from the upstream Docker build (45 MB). Not needed for
# headless runs; fetch it from the upstream repo if you build the image.
docker_build/*.tar.gz

# Simod pool-mode experiment outputs (config and notes live in backend/simod_pool/)
backend/simod_pool/runs/

# Per-run artifacts written by run_experiments.py
*_run_times.csv
*_batch_log.txt

# Working notes: planning documents, migration proposals, session summaries.
# Kept on disk and out of the repository -- they record how decisions were
# reached, which dates quickly, while the READMEs carry what the code does now.
PLANNING_*.md
SCYLLA_PROPOSAL.md
SCYLLA_IMPLEMENTATION_PLAN.md
WHAT_WE_DID.md
commands.md
