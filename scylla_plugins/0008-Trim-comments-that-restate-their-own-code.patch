@@ -53,9 +44,7 @@ public class EligibilityPluginUtils {
      */
     public static final char COPY_SEPARATOR = '#';
 
-    /**
-     * Recovers the model's resource id from a Scylla instance name.
-     */
+    /** Recovers the model's resource id from a Scylla instance name. */
     public static String resourceIdOf(String instanceName) {
         if (instanceName == null) {
             return null;
@@ -64,9 +53,7 @@ public class EligibilityPluginUtils {
         String id = index < 0
                 ? instanceName
                 : instanceName.substring(index + INSTANCE_NAME_SEPARATOR.length());
-        // A resource declared with amount > 1 becomes several interchangeable
-        // instances, named `<pool>__<resourceId>#<copy>`. They are the same
