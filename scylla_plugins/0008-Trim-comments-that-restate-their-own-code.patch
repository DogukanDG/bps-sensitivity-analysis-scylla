From f3a71f43070b0ded61bc27ab11cfb30f048de1bb Mon Sep 17 00:00:00 2001
From: DogukanDG <dagtekindogukan1@gmail.com>
Date: Fri, 11 Sep 2026 12:00:28 +0200
Subject: [PATCH 8/8] Trim comments that restate their own code

Javadoc on five constants repeated the constant name; the eligibility helper
said the same thing twice, once above the method and once inside it; and the
arrival-calendar header explained its measurement twice over.

The measurements stay -- they are why the same wrong guess does not get made
again -- but each is now stated once.
---
 .../ArrivalCalendarPluginUtils.java           |  1 -
 .../ArrivalCalendarSchedulingPlugin.java      | 28 +++++++------------
 .../eligibility/EligibilityPluginUtils.java   | 17 ++---------
 .../ResourceDurationPluginUtils.java          |  4 ---
 4 files changed, 12 insertions(+), 38 deletions(-)

diff --git a/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarPluginUtils.java b/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarPluginUtils.java
index 5f88dfb..dd2c99f 100644
--- a/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarPluginUtils.java
+++ b/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarPluginUtils.java
@@ -15,7 +15,6 @@ package de.hpi.bpt.scylla.plugin.arrivalcalendar;
  */
 public class ArrivalCalendarPluginUtils {
 
-    /** Plugin name. */
     public static final String PLUGIN_NAME = "arrivalCalendar";
 
     /** Key under which the parsed calendar is stored as a simulation extension. */
diff --git a/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarSchedulingPlugin.java b/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarSchedulingPlugin.java
index f9ea7bc..74877a2 100644
--- a/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarSchedulingPlugin.java
+++ b/src/main/java/de/hpi/bpt/scylla/plugin/arrivalcalendar/ArrivalCalendarSchedulingPlugin.java
@@ -22,26 +22,18 @@ import desmoj.core.simulator.TimeSpan;
  * Defers a case that would arrive outside the arrival calendar to the next open
  * window.
  *
- * <b>Deferring, not dropping.</b> A case whose draw lands on a Sunday night is
- * pushed to Monday morning rather than discarded. That keeps the number of
- * simulated cases equal to {@code processInstances}, which is what makes runs
- * comparable across engines and across configurations -- Prosimos compresses
- * the same case count into the open hours, so this is the closer match.
+ * <b>Deferring, not dropping.</b> A case drawn for Sunday night is pushed to
+ * Monday morning, keeping the simulated count equal to {@code processInstances}
+ * -- Prosimos compresses the same count into the open hours.
  *
- * <b>Queued, not stacked.</b> Deferring each arrival on its own puts every case
- * that missed a window at the exact instant it opens. With a run starting on a
- * Sunday and a one-hour Sunday window, all 100 cases of a BPIC 2012 run arrived
- * in the same second, and the queue that produced dominated every measurement
- * taken from it. Deferred arrivals are laid out one after another instead,
- * spaced by the gaps the generation events already carry, which is what
- * Prosimos does when it compresses the same case count into the open hours.
+ * <b>Queued, not stacked.</b> Deferring each arrival independently puts every
+ * missed case at the instant the window opens: with a Sunday start and a
+ * one-hour window, all 100 cases of a BPIC 2012 run arrived in the same second
+ * and the resulting queue dominated every measurement. They are laid out one
+ * after another instead, spaced by the gaps the generation events carry.
  *
- * The cost is that arrivals still bunch after a long closure, since a backlog
- * has to be worked off. That is inherent to deferring rather than dropping, and
- * belongs in any write-up of the results.
- *
- * The calendar arithmetic is not new: DateTimeUtils already locates the current
- * or next window for resource calendars, and this reuses it.
+ * Arrivals still bunch after a long closure, since a backlog has to be worked
+ * off; that is inherent to deferring rather than dropping.
  */
 public class ArrivalCalendarSchedulingPlugin extends ProcessInstanceGenerationEventPluggable {
 
