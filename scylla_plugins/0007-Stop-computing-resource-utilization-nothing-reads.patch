@@ -75,6 +76,46 @@ class ResourceQueue extends PriorityQueue<ResourceObject> {
      * @param retrievalTime : The point in time the resources should be available
      * @return 
      */
+    /**
+     * Takes the first available instance accepted by {@code accept}, leaving
+     * the rest of the queue untouched.
+     *
+     * {@link #pollAvailable(TimeInstant)} drains the whole queue and reinserts
+     * what it did not want. That is affordable when an activity names one
+     * resource type and its queue is short, which is how the core uses it. A
+     * plugin that assigns from a shared pool of every resource pays 47 polls
+     * and 46 inserts per attempt, and SimulationModel repeats the attempt for
+     * every queued event each time any resource frees up -- so the cost grows
+     * with the queue and oversubscribed samples stop finishing.
+     *
+     * This walks the queue in priority order and removes only the instance it
+     * returns. Iteration order of a PriorityQueue is not sorted, so this is a
+     * linear scan rather than a heap pop, but it performs one removal instead
+     * of a full drain and reinsert.
+     */
+    public ResourceObject pollFirstAvailable(TimeInstant retrievalTime,
+                                             Predicate<ResourceObject> accept) {
+        ZonedDateTime retrievalDateTime = DateTimeUtils.getDateTime(retrievalTime);
+        ResourceObject best = null;
+        for (ResourceObject candidate : this) {
+            if (accept != null && !accept.test(candidate)) {
+                continue;
+            }
+            List<TimetableItem> timetable = candidate.getTimetable();
+            if (timetable != null && !candidate.isAvailable(retrievalDateTime)) {
+                continue;
+            }
+            // Same rule as the core's comparator: least recently used first.
+            if (best == null || candidate.getTimeOfLastAccess() < best.getTimeOfLastAccess()) {
+                best = candidate;
+            }
+        }
+        if (best != null) {
+            super.remove(best);
+        }
+        return best;
+    }
+
